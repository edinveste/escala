# Copie este arquivo para .env e preencha com suas credenciais do Supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Contato de Suporte para regularização financeira (DDI + DDD + Número)
VITE_WHATSAPP_SUPORTE=5511999999999

# Manutenção da Landing Page (Defina como 'true' para ativar o aviso Em Construção ou 'false' para a Landing Page normal)
VITE_EM_CONSTRUCAO=true

# Fase 3: Gateway de Pagamentos Asaas (Configuração das Edge Functions no Supabase)
# ASAAS_WEBHOOK_SECRET=token_definido_no_webhook_do_asaas
# ASAAS_API_KEY=$aact_sua_chave_de_api_do_asaas
# ASAAS_ENV=production # ou 'sandbox'
